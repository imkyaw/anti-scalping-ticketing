# Public, browser-visible configuration only.
# Never put private keys, mnemonics or deployment secrets in VITE_* variables.

# Chain the dApp expects MetaMask to use (Hardhat Local = 31337)
VITE_CHAIN_ID=31337

# RPC URL offered to MetaMask when adding the Hardhat Local network
VITE_RPC_URL=http://127.0.0.1:8545

# Optional block explorer base URL (leave empty for Hardhat Local)
VITE_BLOCK_EXPLORER_URL=

# How long a signed check-in QR stays valid, in seconds
VITE_CHECK_IN_QR_TTL_SECONDS=120
